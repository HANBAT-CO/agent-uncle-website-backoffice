# Backoffice (/admin) against the LOCAL Supabase stack in supabase-local/. Safe to commit:
# every value below is a public, well-known local default of the Supabase CLI 2.120.0.
#
# Intended home: /.env.backoffice.local.example at the repo root. It sits here because the
# agent file-protector hook blocks agent writes to `.env.*` paths. To move it (and keep it
# committable despite the `.env*` rule in .gitignore):
#   cp supabase-local/env.backoffice.local.example .env.backoffice.local.example
#   printf '!.env.backoffice.local.example\n' >> .gitignore
#
# You normally do not copy values by hand: `supabase-local/scripts/start.sh` (write-env.mjs)
# writes this block, with your running stack's values, into .env.development.local (gitignored,
# loaded by `next dev` only). The landing's NEXT_PUBLIC_SUPABASE_* in .env.local keep pointing
# at the live project and are NOT overridden: the backoffice uses its own BACKOFFICE_* names.
#
# Never put a service-role / secret key in any Next.js env file. The local service-role key
# lives only in supabase-local/.env.seed.local (gitignored), read only by the seed scripts.

# >>> BACKOFFICE_LOCAL >>>
BACKOFFICE_SUPABASE_TARGET=local
BACKOFFICE_SUPABASE_URL=http://127.0.0.1:55321
BACKOFFICE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# <<< BACKOFFICE_LOCAL <<<

# Local logins (LOCAL ONLY, see supabase-local/README.md):
#   owner (관리자)     admin@agentuncle.local / agentuncle-admin-local
#   operator (운영자)  operator@agentuncle.local / agentuncle-operator-local
#   viewer (열람자)    viewer@agentuncle.local / agentuncle-viewer-local
#   not staff         spare@agentuncle.local / agentuncle-spare-local
#   (roles come from public.backoffice_admins; app_metadata is ignored)
#   demo app users    <slug>@demo.agentuncle.local / agentuncle-demo-local
