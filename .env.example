# Copy to .env.local for local development. All values here are public.

# Absolute origin used for metadataBase, canonical and OG URLs.
# Defaults to this confirmed production origin, including on preview hosts.
# Set a localhost origin only when explicitly testing local metadata.
NEXT_PUBLIC_SITE_URL=https://www.the-saena.ai

# Supabase project shared with the mobile app. The publishable key is already
# shipped in the app; Row Level Security is the security boundary.
# Never add a service-role key to this project.
NEXT_PUBLIC_SUPABASE_URL=https://auicerytbhnqeakmkscs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mOfMxJwI_iWlc7_JQ1MuVA_ApBXJPEd

# E2E ONLY. When 1, the lead action validates a submission and returns success
# WITHOUT inserting it (Playwright runs and the shared dev server use it).
# Never set it in production: every real lead would be dropped. Leave it unset.
# LEAD_DRY_RUN=1
